POSTGRES_USER=username
POSTGRES_PASSWORD=password
POSTGRES_DBNAME=postgis

# Folder mounted into the fileserver container - put your LAS/LAZ and
# panorama files somewhere under here (subfolders are fine).
DATA_DIR=./data

# Where the fileserver container is reachable from wherever you run the
# ingest script and from QGIS.
ASSET_BASE_URL=http://localhost:8081

# Used by the ingest script to talk directly to postgres.
PGSTAC_DSN=postgresql://username:password@localhost:5439/postgis
